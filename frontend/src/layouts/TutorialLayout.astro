---
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  course: any;
  topics: any[];
  currentTopicSlug?: string;
}

const {
  title = 'Tutorial — Allml',
  description = '',
  ogImage = '/og-default.png',
  course,
  topics,
  currentTopicSlug,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <div class="tutorial-layout">
      <Sidebar course={course} topics={topics} currentTopicSlug={currentTopicSlug} />
      <main class="tutorial-content">
        <slot />
      </main>
    </div>

    <script>
      // Mobile sidebar toggle
      document.addEventListener('DOMContentLoaded', () => {
        const menuBtn = document.querySelector('.header__menu-btn');
        const sidebar = document.querySelector('.sidebar');

        if (menuBtn && sidebar) {
          menuBtn.addEventListener('click', () => {
            sidebar.classList.toggle('sidebar--open');
          });
        }

        // Sidebar section toggles
        document.querySelectorAll('.sidebar__item--parent').forEach((item) => {
          item.addEventListener('click', (e) => {
            const children = item.nextElementSibling;
            const toggle = item.querySelector('.sidebar__toggle');
            if (children && children.classList.contains('sidebar__children')) {
              e.preventDefault();
              children.classList.toggle('sidebar__children--collapsed');
              toggle?.classList.toggle('sidebar__toggle--open');
            }
          });
        });
      });
    </script>
  </body>
</html>
