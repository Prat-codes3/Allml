---
interface Props {
  content: {
    headers?: string[];
    rows?: string[][];
  };
}

const { content } = Astro.props;
const headers = content.headers || [];
const rows = content.rows || [];
---

<div class="table-block">
  <div class="table-block__scroll">
    <table>
      {headers.length > 0 && (
        <thead>
          <tr>
            {headers.map((header) => (
              <th>{header}</th>
            ))}
          </tr>
        </thead>
      )}
      <tbody>
        {rows.map((row) => (
          <tr>
            {row.map((cell) => (
              <td>{cell}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
